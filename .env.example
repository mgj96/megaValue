# ─── 필수 ────────────────────────────────────────────────────
# PostgreSQL 연결 URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── 빌드 시 번들에 포함되는 공개 값 ──────────────────────────
NEXT_PUBLIC_POTENTIAL_DATA_VERSION=1
NEXT_PUBLIC_LOG_VERSION=1
NEXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=

# ─── 선택 ────────────────────────────────────────────────────
# 포트 (기본값: 3000)
PORT=3000

# Google Adsense ads.txt 내용
GOOGLE_ADS_TXT_CONTENT=

# GA4 측정 ID
GA4_ID=

# Nexon Open Api Key
NEXON_OPEN_API_KEY=

# ─── 로깅 (Loki) ─────────────────────────────────────────────
# LOKI_HOST=
# LOKI_TOKEN=
# LOKI_USER=
# LOKI_ENVIRONMENT=
# 포트 (기본값: 3000)
PORT=3000

# Google Adsense / GA4 (선택, 비워 두면 비활성)
NEXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=
GOOGLE_ADS_TXT_CONTENT=
GA4_ID=

# 관리자 검수용(선택). 캐릭터 이름 칸에 이 값을 넣으면 넥슨 조회 없이 표본 장비로 진단/프롬프트를 만든다.
# 비워 두면 기능이 꺼진다. 값은 저장소에 커밋하지 말고 Vercel 환경변수에만 설정한다.
ADMIN_TEST_COMMAND=

# 넥슨 오픈 API 키는 서버에 두지 않는다. 사용자가 화면에서 직접 입력하고 요청 헤더로만 전달한다.

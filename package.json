{
  "name": "mesulive",
  "private": true,
  "scripts": {
    "dev:next": "next dev",
    "dev:storybook": "storybook dev -p 6006 --no-open --quiet",
    "dev": "concurrently \"pnpm dev:next\" \"pnpm dev:storybook\"",
    "build": "pnpm generate-ads-txt && next build",
    "build:analyze": "ANALYZE=true next build",
    "generate-ads-txt": "tsx scripts/generateAds.ts",
    "start": "next start",
    "lint": "next lint",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "packageManager": "pnpm@9.15.1",
  "dependencies": {
    "@heroui/react": "^2.7.5",
    "@next/env": "^15.1.7",
    "@next/third-parties": "15.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "jsdom": "^24.1.3",
    "next": "15.1.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "ts-pattern": "^5.6.0",
    "usehooks-ts": "^3.1.0",
    "vaul": "^0.9.9",
    "yaml": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@kurateh/eslint-plugin": "^1.0.0",
    "@next/bundle-analyzer": "^15.1.3",
    "@next/eslint-plugin-next": "^15.1.2",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/addon-themes": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@svgr/webpack": "^8.1.0",
    "@types/eslint": "^9.6.1",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-storybook": "^0.11.1",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-classnames": "^0.7.5",
    "prettier-plugin-merge": "^0.7.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "storybook": "^8.4.7",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "@heroui/input": "patches/@heroui__input.patch"
    }
  }
